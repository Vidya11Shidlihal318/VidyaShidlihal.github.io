<title>Vidya Shidlihal | Engineering Portfolio</title>

<style>
:root {
    --navy: #14243d;
    --blue: #1769aa;
    --cyan: #19a5bd;
    --light: #f3f7fc;
    --text: #26364b;
    --muted: #607087;
    --white: #ffffff;
    --border: #dce5ef;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 85px;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--light);
    color: var(--text);
    line-height: 1.7;
}

a {
    color: var(--blue);
}

.container {
    width: 90%;
    max-width: 1100px;
    margin: auto;
}

nav {
    background: var(--navy);
    padding: 16px 0;
    position: sticky;
    top: 0;
    z-index: 100;
}

.nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
}

.logo {
    color: white;
    font-size: 19px;
    font-weight: bold;
    text-decoration: none;
}

.nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 17px;
}

.nav-links a {
    color: #edf5ff;
    font-size: 13px;
    text-decoration: none;
}

.nav-links a:hover {
    color: #63e0ed;
}

.hero {
    background: linear-gradient(135deg, #14243d, #185c85);
    color: white;
    padding: 90px 20px;
    text-align: center;
}

.hero .eyebrow {
    color: #83e1ed;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 13px;
    font-weight: bold;
}

.hero h1 {
    font-size: clamp(34px, 6vw, 54px);
    line-height: 1.2;
    margin: 17px 0;
}

.hero h2 {
    color: #d6e9fa;
    font-size: clamp(17px, 3vw, 23px);
    font-weight: normal;
}

.hero p {
    max-width: 680px;
    margin: 18px auto;
    color: #e1ebf6;
}

.hero-buttons {
    margin-top: 28px;
}

.btn {
    display: inline-block;
    padding: 12px 22px;
    margin: 5px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    font-size: 14px;
}

.btn-primary {
    background: var(--cyan);
    color: white;
}

.btn-outline {
    border: 1px solid white;
    color: white;
}

.btn:hover {
    opacity: 0.85;
}

section {
    padding: 65px 0;
}

.section-title {
    text-align: center;
    margin-bottom: 35px;
}

.section-title h2 {
    font-size: 30px;
    color: var(--navy);
    margin-bottom: 8px;
}

.section-title p {
    color: var(--muted);
    font-size: 15px;
}

.about-box,
.education-box,
.contact-box {
    background: white;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 5px 18px rgba(20, 36, 61, 0.04);
}

.about-box p {
    margin-bottom: 14px;
}

.interest-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
}

.interest-list span {
    background: #e7f3fc;
    color: #185486;
    padding: 8px 13px;
    border-radius: 5px;
    font-size: 13px;
}

.skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.skill-card,
.project-card {
    background: white;
    padding: 25px;
    border: 1px solid var(--border);
    border-radius: 11px;
    box-shadow: 0 4px 15px rgba(20, 36, 61, 0.04);
}

.skill-card h3,
.project-card h3 {
    color: var(--blue);
    font-size: 18px;
    margin-bottom: 13px;
}

.skill-card p {
    color: var(--muted);
    font-size: 14px;
}

.tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.tags span {
    background: #edf4fb;
    color: #254968;
    padding: 6px 10px;
    border-radius: 5px;
    font-size: 12px;
}

.project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.project-card {
    border-top: 4px solid var(--cyan);
}

.project-card p {
    color: var(--muted);
    font-size: 14px;
    margin: 12px 0;
}

.project-card .tech {
    color: var(--blue);
    font-weight: bold;
    font-size: 13px;
}

.education-box h3 {
    color: var(--blue);
    margin-bottom: 7px;
}

.education-box p {
    margin: 5px 0;
}

.education-box .education-item + .education-item {
    border-top: 1px solid var(--border);
    margin-top: 23px;
    padding-top: 23px;
}

.achievement {
    background: #e9f5fc;
    border-left: 4px solid var(--cyan);
    padding: 22px;
    border-radius: 7px;
}

.achievement h3 {
    color: var(--navy);
    margin-bottom: 6px;
}

.contact-box {
    text-align: center;
}

.contact-box p {
    margin: 12px 0;
    overflow-wrap: anywhere;
}

.contact-box a {
    text-decoration: none;
    font-weight: bold;
}

footer {
    background: var(--navy);
    color: #d8e4f1;
    text-align: center;
    padding: 24px 15px;
    font-size: 13px;
}

@media (max-width: 760px) {
    .nav-content {
        flex-direction: column;
    }

    .nav-links {
        justify-content: center;
        gap: 12px;
    }

    .skills-grid,
    .project-grid {
        grid-template-columns: 1fr;
    }

    .hero {
        padding: 65px 18px;
    }

    section {
        padding: 45px 0;
    }

    .about-box,
    .education-box,
    .contact-box,
    .skill-card,
    .project-card {
        padding: 22px;
    }
}
</style>
</head>

